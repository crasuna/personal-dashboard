# Real records, cloud credentials and all local backups must stay private.
data/
backups/
recovery*/
db*.json
sync-config*.json
offline-state*.json
device-*.json
# JSON exports may have arbitrary names; only reviewed npm manifests are source.
*.json
!/package.json
!/package-lock.json
*.db
*.sqlite*
*.csv
*.log
*.tmp
*.bak
.env
.env.*
!.env.example
*password*.txt
*secret*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Generated binaries go to GitHub Releases, never source history.
android/signing/
android/build/
android/dist/
dist/
artifacts/
*.apk
*.idsig
*.zip
*.tar.gz

# Local developer / test output.
__pycache__/
*.py[cod]
node_modules/
.venv/
venv/
.idea/
.vscode/
.codex/
test-results/
playwright-report/
.DS_Store
Thumbs.db

# Machine-specific legacy launchers / private setup notes stay on this computer.
/启动面板.vbs
/手机与电脑同步使用说明.md
.local/
*.local.*
